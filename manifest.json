{
  "manifest_version": 3,
  "name": "WebClaw",
  "version": "0.7.3",
  "minimum_chrome_version": "135",
  "description": "A user-controlled browser AI assistant for conversations, page actions, tools, and optional advanced automation.",
  "permissions": [
    "alarms",
    "identity",
    "offscreen",
    "sidePanel",
    "scripting",
    "storage",
    "tabs",
    "userScripts",
    "windows"
  ],
  "optional_permissions": [
    "bookmarks",
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "history",
    "notifications",
    "sessions",
    "tabGroups"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open WebClaw",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; style-src 'self' 'unsafe-inline' data: blob:"
  },
  "sandbox": {
    "pages": ["src/preview-sandbox.html", "src/document-engine-sandbox.html", "src/script-runner-sandbox.html"]
  }
}
